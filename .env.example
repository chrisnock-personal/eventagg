# =============================================================================
# EventAgg -Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values before running:
#
#   cp .env.example .env
#   podman-compose up -d --build
#
# The .env file is read by docker-compose.yml.
# Never commit .env to version control.
# =============================================================================

# ── PostgreSQL application credentials ───────────────────────────────────────
# Created automatically on first run if they do not exist.
PGDATABASE=eventagg
PGUSER=eventagg_user
PGPASSWORD=change_me_app_password

# ── PostgreSQL superuser password ─────────────────────────────────────────────
# Used only during container initialisation to create the app user/database.
POSTGRES_PASSWORD=change_me_admin_password

# ── PostgreSQL connection pool tuning (optional) ─────────────────────────────
# PG_POOL_MAX=10
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_POOL_CONNECTION_TIMEOUT_MS=5000

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production

# Password set for the "admin" user in the Default Organisation on first
# boot. Force-prompts a password change on first login regardless -this
# just controls what that initial password is. Ignored on later boots once
# the admin user already exists (except the hash itself is always reset to
# match, so this still takes effect if you change it and restart).
# ADMIN_PASSWORD=admin123

# JWT signing secret. Set this explicitly in production -if unset, a
# random secret is generated every time the process starts, invalidating
# every session on each restart. There is no insecure hardcoded fallback.
# JWT_SECRET=

# Marks the session cookie Secure (HTTPS-only). Only enable once you've put
# TLS in front of this app (see README's TLS section) -nginx.conf itself
# serves plain HTTP, and browsers silently drop Secure cookies over HTTP,
# breaking every login.
# COOKIE_SECURE=false

# Same-origin only by default (empty) -this app's own nginx.conf proxies
# the frontend and API on the same origin, so no cross-origin browser
# request is ever needed for the standard deployment. Only set this if a
# separately-hosted frontend calls this API directly (see README's CORS
# section) -a specific origin, not "*", if that frontend needs to stay
# logged in via the session cookie.
# CORS_ORIGIN=

# ── SNMP trap receiver ────────────────────────────────────────────────────────
# SNMP_ENABLED=true
# SNMP_PORT=1162
# SNMP_COMMUNITY=public

# Ingest auth (X-API-Key) is NOT an env var -since multi-tenancy Phase 1,
# each organisation has its own generated API key
# (organisations.ingest_api_key), managed via the Organizations panel.
# There is no global ingest key to set here.

# ── Networking ────────────────────────────────────────────────────────────────
# docker-compose.yml uses network_mode: host (required for SNMP UDP to work
# under rootless Podman) -services bind directly to host ports, so there
# are no HOST_PORT/API_PORT/PG_PORT variables to set. The frontend is on
# 8080, the API on 3001 (proxied through the frontend at /api/v1 -see
# nginx.conf), and SNMP on SNMP_PORT above.

# ── Base image (optional) ─────────────────────────────────────────────────────
# Controls which Linux distribution the container is built on.
# The install script detects the distro and uses the correct package manager.
#
# Supported values:
#   ubuntu:22.04   (default)
#   ubuntu:24.04
#   debian:12
#   debian:11
#   fedora:40
#   fedora:39
#   rockylinux:9
#   rockylinux:8
#   almalinux:9
#   almalinux:8
#   amazonlinux:2023
#
# BASE_IMAGE=ubuntu:22.04
