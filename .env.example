# =============================================================================
# EventAgg -Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values before running:
#
#   cp .env.example .env
#   podman-compose up -d --build
#
# The .env file is read by docker-compose.yml.
# Never commit .env to version control.
# =============================================================================

# ── PostgreSQL credentials ───────────────────────────────────────────────────
# Created automatically on first run if they do not exist. Leave the two
# passwords unset and random ones are generated on first boot into the
# `secrets` volume (/app/secrets/pg_app.pass, pg_super.pass). Set them to
# manage them yourself; either way they're applied on every boot.
# Postgres listens on 127.0.0.1 only: use an SSH tunnel for remote access.
PGDATABASE=eventagg
PGUSER=eventagg_user
# PGPASSWORD=
# POSTGRES_PASSWORD=

# ── PostgreSQL connection pool tuning (optional) ─────────────────────────────
# PG_POOL_MAX=10
# PG_POOL_IDLE_TIMEOUT_MS=30000
# PG_POOL_CONNECTION_TIMEOUT_MS=5000

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production

# Password for the "admin" user in the Default Organisation, used only when
# that user is first created. Unset = a random one-time password, printed
# once to the backend log. Either way it must be changed at first login (the
# API refuses everything else until it is). Later boots leave it alone.
# ADMIN_PASSWORD=

# Lockout recovery: "true" resets the admin's password at the next boot (to
# ADMIN_PASSWORD, or a generated one printed to the log) and forces a change
# at login. Remove it again straight after.
# ADMIN_PASSWORD_RESET=false

# JWT signing secret. Leave unset and one is generated on first boot and
# persisted in the `secrets` volume, so sessions survive restarts. Set it to
# manage the secret yourself. "<new>,<old>" accepts both during a rotation
# (SECRETS_ROTATION.md). There is no insecure hardcoded fallback.
# JWT_SECRET=

# Marks the session cookie Secure (HTTPS-only). Only enable once you've put
# TLS in front of this app (see README's TLS section) -nginx.conf itself
# serves plain HTTP, and browsers silently drop Secure cookies over HTTP,
# breaking every login.
# COOKIE_SECURE=false

# Same-origin only by default (empty) -this app's own nginx.conf proxies
# the frontend and API on the same origin, so no cross-origin browser
# request is ever needed for the standard deployment. Only set this if a
# separately-hosted frontend calls this API directly (see README's CORS
# section) -a specific origin, not "*", if that frontend needs to stay
# logged in via the session cookie.
# CORS_ORIGIN=

# ── SNMP trap receiver ────────────────────────────────────────────────────────
# SNMP_ENABLED=true
# SNMP_PORT=1162
# Sets the Default Organisation's community string on every boot. Unset, it
# keeps its own (random; admins see it in the SNMP panel). It's the only
# SNMPv2c credential: traps with an unregistered community are rejected.
# SNMP_COMMUNITY=

# Ingest auth (X-API-Key) is NOT an env var -since multi-tenancy Phase 1,
# each organisation has its own generated API key
# (organisations.ingest_api_key), managed via the Organizations panel.
# There is no global ingest key to set here.

# ── Networking ────────────────────────────────────────────────────────────────
# docker-compose.yml uses network_mode: host (required for SNMP UDP to work
# under rootless Podman) -services bind directly to host ports, so there
# are no HOST_PORT/API_PORT/PG_PORT variables to set. The frontend is on
# 8080 and SNMP on SNMP_PORT above. The API listens on 127.0.0.1:3001 and is
# reached through the frontend at /api/v1 (nginx.conf); Postgres listens on
# 127.0.0.1:5432. Only set BIND_ADDRESS=0.0.0.0 if something must reach the
# API without nginx, knowing that bypasses any TLS added there.
# BIND_ADDRESS=127.0.0.1

# ── Base image (optional) ─────────────────────────────────────────────────────
# Controls which Linux distribution the container is built on.
# The install script detects the distro and uses the correct package manager.
#
# Supported values:
#   ubuntu:22.04   (default)
#   ubuntu:24.04
#   debian:12
#   debian:11
#   fedora:40
#   fedora:39
#   rockylinux:9
#   rockylinux:8
#   almalinux:9
#   almalinux:8
#   amazonlinux:2023
#
# BASE_IMAGE=ubuntu:22.04
